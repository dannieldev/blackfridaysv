# ==========================================
# Configuración Radar Black Friday El Salvador
# ==========================================

# Supabase (Base de datos y API)
# Obtén estas claves en tu proyecto Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica-para-el-frontend

# Clave de Servicio (SOLO para GitHub Actions y scripts locales de scraping en scrapers/)
# NUNCA exponer en el frontend ni en repositorios públicos
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-privada

# Modo de Scraping ('dry-run' no guarda en DB, 'production' guarda en DB)
SCRAPER_MODE=dry-run

# Límite de páginas/productos por categoría para pruebas locales (dejar vacío para extraer todo)
SCRAPE_MAX_ITEMS_PER_CATEGORY=20
